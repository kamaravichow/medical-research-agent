# --- LLM (any LangChain init_chat_model string; "provider:model") ---
MEDAGENT_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # if you set MEDAGENT_MODEL=openai:...

# --- TinyFish (web search + page fetch) ---
TINYFISH_API_KEY=

# --- Free biomedical providers (all optional; raise rate limits) ---
NCBI_API_KEY=                # https://www.ncbi.nlm.nih.gov/account/ -> API key (10 req/s instead of 3)
NCBI_EMAIL=                  # NCBI asks callers to identify themselves
OPENFDA_API_KEY=             # https://open.fda.gov/apis/authentication/

# --- Harness ---
MEDAGENT_DATA_DIR=./data     # saved watch topics + library
